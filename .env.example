# InsForge
NEXT_PUBLIC_INSFORGE_URL=https://xxxxxxxxxxxx.xx-xxxxx.insforge.app
# Anon key pública (la usa el navegador). Dashboard -> Install -> API Keys,
# o: npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Solo en el servidor: API_KEY de admin (ik_...) para el webhook de Telegram,
# /api/plan-dia y el cron. Nunca la expongas con NEXT_PUBLIC_.
INSFORGE_API_KEY=ik_...

# IA (clasificación de tareas en el bot)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...
# Opcional pero recomendado: se valida contra la cabecera
# X-Telegram-Bot-Api-Secret-Token al recibir el webhook
TELEGRAM_WEBHOOK_SECRET=

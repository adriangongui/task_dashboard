# InsForge
NEXT_PUBLIC_INSFORGE_URL=https://xxxxxxxxxxxx.xx-xxxxx.insforge.app
# Anon key pública (la usa el navegador). Dashboard -> Install -> API Keys,
# o: npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Solo en el servidor: API_KEY de admin (ik_...) para el webhook de Telegram,
# /api/plan-dia y el cron. Nunca la expongas con NEXT_PUBLIC_.
INSFORGE_API_KEY=ik_...

# IA (clasificación de tareas en el bot) — Groq, API compatible con OpenAI
GROQ_API_KEY=gsk_...
# Opcional: modelo de Groq. Por defecto openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Acceso al panel. Si no defines ninguna, se usa la contraseña de siempre.
# APP_PASSWORD en claro o APP_PASSWORD_HASH como sha256 en hexadecimal.
APP_PASSWORD=
APP_PASSWORD_HASH=
# Opcional: secreto que firma la cookie de sesión. Cambiarlo cierra todas las
# sesiones abiertas.
APP_SESSION_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...
# Opcional: chat al que pertenece el bot (informativo; el webhook responde
# siempre al chat que escribe)
TELEGRAM_CHAT_ID=
# Opcional pero recomendado: se valida contra la cabecera
# X-Telegram-Bot-Api-Secret-Token al recibir el webhook
TELEGRAM_WEBHOOK_SECRET=
